// Policy net — current state, with the LOOP-BACK edges drawn explicitly.
//
// The two arrows that matter are:
//     MACRO action -> tokenize path/accumulation -> palimpsa
//     MICRO action -> tokenize approx + new accumulation -> palimpsa
// Every action must re-enter the encoder before the next decision. palimpsa is
// a linear-attention RECURRENCE, so each re-entry costs only the new tokens.
//
// Traced from source:
//   Agent.encode / sample_action_dynamic  -> approx/ppo.py
//   MicroActionHead.sample_step           -> approx/heads.py
//   AutoregressiveFaceDriver              -> approx/face_stream.py
//   incremental_encoder.extend            -> approx/incremental_encoder.py:148
//   IncrementalPathTokenizer              -> graphax/jaxpr.py:969
//
// LEGEND
//   green solid  = loop closed by AutoregressiveFaceDriver (built, 8/8 tests)
//   red   dashed = still open in the TRAINER (lax.scan over cached contexts)
//
// Render:  dot -Tsvg policy_forward.dot -o policy_forward.svg

digraph policy_net {
  rankdir=TB;
  bgcolor="transparent";
  splines=spline;
  nodesep=0.34;
  ranksep=0.42;
  node [shape=box, style="rounded,filled", fillcolor="#f4f4f2",
        color="#d0cfca", fontname="Helvetica", fontsize=11,
        margin="0.13,0.08"];
  edge [color="#6a6a68", arrowsize=0.7, fontname="Helvetica", fontsize=9];

  base [label="base function tokenized  (ONCE)\nIncrementalPathTokenizer.base_tokens()"];

  // ---- THE RECURRENCE: everything loops back here ----
  pal [label="◆  palimpsa  ◆\nincremental_encoder.extend(state, NEW tokens only)\nlinear-attention carry — O(delta), never re-reads\n→ vertex_contexts (V,E) + summary (E,)",
       shape=box, style="rounded,filled", fillcolor="#eceaf5", color="#6b5bd6",
       penwidth=2.2, fontsize=12];

  base -> pal;

  vhead [label="VALUE — 4 heads\nflops · peak_memory · cosine_sim · frob_residual\ncosine is TRAINED now",
         fillcolor="#e8f5e9", color="#2e7d32"];
  pal -> vhead [label=" summary"];

  // ---------------- MACRO ----------------
  macro [label="MACRO ACTION\nPointerVertexPolicy → mask(−1e9) → Categorical\n→ vertex_idx   (no special token needed:\nthe path header already names the vertex)"];
  pal -> macro [label=" vertex_contexts"];

  tok_path [label="tokenize LOCAL PATH / face accumulation\npath < d0 * d1 * … >",
            fillcolor="#ffffff", color="#2e7d32"];
  macro -> tok_path [color="#2e7d32", penwidth=1.6];

  // >>> LOOP-BACK 1 <<<
  tok_path -> pal [color="#2e7d32", penwidth=2.0, constraint=false,
                   label="  LOOP 1\n  re-encode before deciding",
                   fontcolor="#2e7d32", fontsize=10];

  // ---------------- SKIP? ----------------
  skipq [label="skip this path?", shape=diamond, fillcolor="#ffffff",
         color="#6b5bd6", fontsize=10];
  tok_path -> skipq;

  tok_skip [label="emit  approx SKIP\nNO new accumulation (edge deleted)",
            fillcolor="#ffffff", color="#2e7d32"];
  skipq -> tok_skip [label="yes"];
  tok_skip -> pal [color="#2e7d32", penwidth=2.0, constraint=false,
                   label="  LOOP 2", fontcolor="#2e7d32", fontsize=10];

  // ---------------- MICRO ----------------
  micro [label="MICRO ACTION  (heads, on the live operand)\nOpTypeHead → AxisPointer i → j (j_context =\nsummary + axis_tokens[i]) → PrimeExponent |\nCompressKind | FactoredQuant (sign + 7 factors)"];
  skipq -> micro [label="no"];

  tok_approx [label="emit  approx <DIAG|COMPRESS|QUANT> <args>\n+ the NEW post-approx accumulation",
              fillcolor="#ffffff", color="#2e7d32"];
  micro -> tok_approx [color="#2e7d32", penwidth=1.6];

  // >>> LOOP-BACK 3 <<<
  tok_approx -> pal [color="#2e7d32", penwidth=2.0, constraint=false,
                     label="  LOOP 3\n  next decision sees this",
                     fontcolor="#2e7d32", fontsize=10];

  // ---------------- repeat arcs ----------------
  more_a [label="another approx on this path?", shape=diamond,
          fillcolor="#ffffff", color="#6b5bd6", fontsize=10];
  more_p [label="another path (face)?", shape=diamond,
          fillcolor="#ffffff", color="#6b5bd6", fontsize=10];
  more_v [label="another vertex?", shape=diamond,
          fillcolor="#ffffff", color="#6b5bd6", fontsize=10];

  tok_approx -> more_a;
  tok_skip   -> more_p;
  more_a -> micro    [label="yes", color="#2e7d32", constraint=false];
  more_a -> more_p   [label="no"];
  more_p -> tok_path [label="yes", color="#2e7d32", constraint=false];
  more_p -> more_v   [label="no"];
  more_v -> macro    [label="yes", color="#2e7d32", constraint=false];

  // ---------------- env / reward ----------------
  env [label="env.step → graphax jacve\ntransforms | face_transforms (--per-face)"];
  more_v -> env [label="no — order complete"];

  sent [label="DEGENERATE-PLAN SENTINEL\nno work or no Jacobian → every cost := −1e10, NOT 0",
        fillcolor="#e8f5e9", color="#2e7d32"];
  env -> sent;

  rew [label="8 channels → symlog → GAE → PopArt\n→ preference → PPO",
       fillcolor="#e8f5e9", color="#2e7d32"];
  sent -> rew;

  // ---------------- the honest caveat ----------------
  gap [label="STATUS OF THESE THREE LOOPS\nCLOSED in AutoregressiveFaceDriver (face_stream.py, 8/8 tests):\nemissions use the tokenizer's real vocabulary and each one calls\nincremental_encoder.extend() before the next decision.\n\nSTILL OPEN in the TRAINER: ppo.py calls Agent.encode() ONCE per env\nstep and runs the micro sub-episode as a lax.scan over CACHED\nvertex_contexts — so in training these three arrows do not yet fire.",
       shape=note, fillcolor="#ffffff", color="#c0392b", fontcolor="#c0392b",
       fontsize=10];
  pal -> gap [style=dashed, color="#c0392b", dir=none, constraint=false];
}
