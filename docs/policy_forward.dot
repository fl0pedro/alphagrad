// Policy net — current state after this cycle's fixes (nn256 / PPO).
//
// Traced from source:
//   Agent fields, Agent.encode, sample_action_dynamic -> approx/ppo.py
//   MicroActionHead.sample_step head order            -> approx/heads.py
//   FACTOR_ORDER (7 quant factors)                    -> approx/quant_factoring.py:37
//   AutoregressiveFaceDriver                          -> approx/face_stream.py
//   decode_vertex_rule_specs (oracle replay)          -> approx/env.py:1060
//   _SENTINEL_BAD_REWARD (degenerate guard)           -> approx/env.py
//   MAX_AXES_PER_VERTEX=8, NUM_OPS=4, MAX_PRIMES=9    -> approx/env.py:359, heads.py:83,97
//
// LEGEND
//   green = added / fixed this cycle
//   red   = the one remaining gap (module exists + tested, not driving training)
//
// Render:  dot -Tsvg policy_forward.dot -o policy_forward.svg

digraph policy_net {
  rankdir=TB;
  bgcolor="transparent";
  compound=true;
  splines=spline;
  nodesep=0.30;
  ranksep=0.38;
  node [shape=box, style="rounded,filled", fillcolor="#f4f4f2",
        color="#d0cfca", fontname="Helvetica", fontsize=11,
        margin="0.13,0.08"];
  edge [color="#6a6a68", arrowsize=0.7, fontname="Helvetica", fontsize=9];

  // ------------------------------------------------ trunk
  subgraph cluster_trunk {
    label="TRUNK  ·  Agent.encode()";
    labeljust="l"; fontname="Helvetica-Bold"; fontsize=10; fontcolor="#6a6a68";
    color="#d0cfca"; style="rounded";

    tok [label="tokens (MAX_TOKENS,) + eqn_ids\nALPHAGRAD_MAX_TOKENS now configurable",
         fillcolor="#e8f5e9", color="#2e7d32"];
    emb [label="embedding + pos_enc\nPositionalEncoder sized from MAX_TOKENS",
         fillcolor="#e8f5e9", color="#2e7d32"];
    enc [label="palimpsa Encoder\nlinear attention → enc_x (S,E)",
         fillcolor="#eceaf5", color="#6b5bd6"];
    ctx [label="vertex_contexts (V,E) + summary (E,)\n(+ vertex_feature_proj, residual_state, pref_proj)"];
    tok -> emb -> enc -> ctx;
  }

  // ------------------------------------------------ value
  vhead [label="VALUE — 4 heads (was 3)\nflops · peak_memory · cosine_sim · frob_residual\ncosine is TRAINED now (--lambda-acc 2.0)",
         fillcolor="#e8f5e9", color="#2e7d32"];
  ctx -> vhead [label="summary"];

  // ------------------------------------------------ macro
  subgraph cluster_macro {
    label="MACRO ACTION  ·  one vertex per env step";
    labeljust="l"; fontname="Helvetica-Bold"; fontsize=10; fontcolor="#6a6a68";
    color="#d0cfca"; style="rounded";
    vpol [label="PointerVertexPolicy → vertex_logits (V,)"];
    vsam [label="where(avail>0.5, logits, −1e9)\nsoftmax → Categorical → vertex_idx"];
    vpol -> vsam;
  }
  ctx -> vpol;

  oracle [label="LiveVertexMaskOracle  (host, jax.pure_callback)\nreplayed with the ACTUALLY-APPLIED rules\n(decode_vertex_rule_specs — was rules=())\n→ pair_valid (8,8) · compress_valid (8,)",
          shape=note, fillcolor="#e8f5e9", color="#2e7d32", fontcolor="#2e7d32"];
  vsam -> oracle [style=dashed, color="#2e7d32"];

  // ------------------------------------------------ micro heads
  subgraph cluster_micro {
    label="MICRO SUB-EPISODE  ·  ≤ max_substeps on the chosen vertex";
    labeljust="l"; fontname="Helvetica-Bold"; fontsize=10; fontcolor="#6a6a68";
    color="#6b5bd6"; style="rounded";

    aenc [label="AxisSetEncoder\nself-attn over ≤8 axis tokens\n→ axis_tokens (N,E) + summary",
          fillcolor="#eceaf5", color="#6b5bd6"];
    ophd [label="OpTypeHead — masked softmax, NUM_OPS=4\nDIAG · COMPRESS · QUANT · END"];
    ihd  [label="AxisPointerHead (i)"];
    jhd  [label="AxisPointerHead (j)\nj_context = summary + axis_tokens[i]\nj_mask = j_mask_for_i_diag[i]   ← autoregressive"];
    fhd  [label="PrimeExponentHead\nexponents over MAX_PRIMES=9"];
    khd  [label="CompressKindHead\nmean min max median abs_min abs_max"];
    qhd  [label="FactoredQuantHead\nsign(±) + 7 factors: kind bits exp\nmantissa bias finite unsigned0\n→ tuple-match → catalog dtype"];

    aenc -> ophd;
    ophd -> ihd [label="DIAG|COMPRESS"];
    ihd  -> jhd [label="DIAG"];
    jhd  -> fhd;
    ophd -> khd [label="COMPRESS"];
    ophd -> qhd [label="QUANT"];
  }
  vsam   -> aenc [label="axis_state[v]"];
  oracle -> ihd  [style=dashed, color="#2e7d32", label="−1e9"];
  oracle -> jhd  [style=dashed, color="#2e7d32"];

  gate [label="≥2-options rule\n1 option → forced (0 logp, 0 entropy, arity 0)\n0 → head dropped;  entropy is arity-normalised",
        shape=note, fillcolor="#ffffff", color="#6b5bd6", fontcolor="#6b5bd6"];
  ophd -> gate [style=dashed, color="#6b5bd6", dir=none];

  // ------------------------------------------------ two consumers of the heads
  scan [label="TRAINS TODAY:  lax.scan over CACHED contexts\nencode() runs ONCE per env step\n→ decisions NOT conditioned on their own tokens",
        fillcolor="#ffffff", color="#c0392b", fontcolor="#c0392b"];

  loop [label="AutoregressiveFaceDriver  (face_stream.py)\nper face:  emit path/accumulation → extend(carry)\n→ decide → emit  approx <SKIP|DIAG|COMPRESS|QUANT>\n+ NEW accumulation (none if SKIP) → extend → repeat\nreal tokenizer vocabulary · 8/8 tests",
        fillcolor="#e8f5e9", color="#2e7d32"];

  gapnote [label="GAP — implemented + tested, NOT wired into the trainer.\nWiring it moves the micro loop host-side (into the\nface_transforms callable, the only mid-elimination hook\nIncrementalJaxpr offers) and reshapes the PPO trajectory.",
           shape=note, fillcolor="#ffffff", color="#c0392b", fontcolor="#c0392b", fontsize=10];
  loop -> gapnote [style=dashed, color="#c0392b", dir=none];

  fhd -> scan; khd -> scan; qhd -> scan;
  fhd -> loop [style=dashed, color="#2e7d32"];

  // ------------------------------------------------ env + reward
  env [label="micro_actions → rule_specs → StepAction\nenv.step (io_callback) → graphax jacve\ntransforms | face_transforms (--per-face)",
       fillcolor="#e8f5e9", color="#2e7d32"];
  scan -> env;
  loop -> env [style=dashed, color="#2e7d32"];

  sent [label="DEGENERATE-PLAN SENTINEL\nno work (muls≤0 & flops≤0) or no Jacobian (cos≤1e-6)\n→ every cost := −1e10, NOT 0\n(a zero-work plan is INVALID, not cheap)",
        fillcolor="#e8f5e9", color="#2e7d32"];
  env -> sent;

  rew [label="8 reward channels → symlog → GAE\n→ PopArt (per-channel μ,σ) → preference → PPO",
       fillcolor="#e8f5e9", color="#2e7d32"];
  sent -> rew;
}
